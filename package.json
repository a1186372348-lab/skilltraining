{
  "name": "skilltraining",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "node --env-file=.env scripts/prepare-test-db.ts",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "content:validate": "node scripts/validate-content.ts",
    "content:import": "node scripts/import-content.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "js-yaml": "^5.4.2",
    "next": "16.4.5",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "29.1.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
