# PostgreSQL 连接串（本地开发对应 docker-compose.yml，宿主机端口 5433）
# 注意：Windows 下请使用 127.0.0.1 而非 localhost（localhost 可能解析到 IPv6 ::1，Docker 端口映射仅生效于 IPv4）
DATABASE_URL="postgresql://skilltraining:skilltraining_local_only@127.0.0.1:5433/skilltraining?schema=public"

# 测试专用库（T14：全部测试运行于独立库 skilltraining_test，与开发库隔离；
# npm run test 的 pretest 钩子会自动建库并执行 prisma migrate deploy，无需手工准备）
TEST_DATABASE_URL="postgresql://skilltraining:skilltraining_local_only@127.0.0.1:5433/skilltraining_test?schema=public"

# DeepSeek 开放平台 API Key（追问/评分主模型，OpenAI 兼容；仅存服务端，禁止下发前端，见 Prd.md 3.5）
DEEPSEEK_API_KEY=""

# DeepSeek OpenAI 兼容 API 基础地址（官方默认；模型名固定 deepseek-flash，即最新 V4.1-Flash-1017）
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# 会话 cookie 签名密钥（T03；生产环境必填，缺失会导致启动失败；开发环境可留空，将生成临时随机密钥）
AUTH_SECRET=""

# 应用基础地址（拼接魔法链接用）
APP_BASE_URL="http://localhost:3000"

# SMTP 真实发信（默认留空走控制台投递；配置 SMTP_HOST 后启用 SmtpMailer）
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""

# ────────────────────────────────────────────────────────────
# 生产部署说明（Vercel + Neon，T39；以下均为占位示例，勿填真实密钥入库）
#
# 1) DATABASE_URL：使用 Neon 的 pooled 连接串（带 -pooler 主机名与 pgbouncer 参数），形如
#    postgresql://<用户>:<密码>@<项目>-pooler.<区域>.aws.neon.tech/<库名>?sslmode=require&pgbouncer=true&connection_limit=1
#
# 2) QQ 邮箱 SMTP：需先在 QQ 邮箱「设置 → 账户」开启 SMTP 服务并取得授权码，
#    授权码填入 SMTP_PASS（非邮箱登录密码）；SMTP_FROM 与 SMTP_USER 填同一邮箱地址：
#    SMTP_HOST="smtp.qq.com"
#    SMTP_PORT="465"
#    SMTP_SECURE="true"
#    SMTP_USER="yourname@qq.com"
#    SMTP_PASS="<16 位授权码>"
#    SMTP_FROM="yourname@qq.com"
#
# 3) AUTH_SECRET：生产环境必填（缺失会导致启动失败），可用以下命令生成：
#    openssl rand -base64 32
#
# 4) APP_BASE_URL：填 Vercel 分配的域名（拼接魔法链接用），如 https://your-app.vercel.app
